# Copy to .env for local development. Never commit .env.
# In production, set these in Render / Streamlit secrets instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: require this key in the X-API-Key header on /search.
# Set the same value in Streamlit secrets so the frontend sends it.
TRAVEL360_API_KEY=

# Optional: comma-separated browser origins allowed by CORS.
ALLOWED_ORIGINS=

# Optional: set to 1 to expose /docs and /openapi.json.
ENABLE_DOCS=0
